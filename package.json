{
  "name": "albo-os",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -k -n vite,convex -c blue,magenta \"pnpm dev:vite\" \"pnpm dev:convex\"",
    "dev:vite": "vite dev",
    "dev:convex": "convex dev",
    "build": "vite build && tsc --noEmit",
    "build:vercel": "if [ \"$VERCEL_ENV\" = \"production\" ] && [ -n \"$CONVEX_DEPLOY_KEY\" ]; then npx convex deploy --cmd 'pnpm build'; else echo '[albo-os] Skipping convex deploy (not Vercel production env or CONVEX_DEPLOY_KEY missing).'; pnpm build; fi",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "tsgo --noEmit",
    "format": "prettier --write .",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:skills:verify": "node scripts/sync-skills.mjs --verify",
    "sync:skills:check": "node scripts/sync-skills.mjs --check",
    "setup": "node scripts/setup.mjs",
    "setup:prod": "node scripts/setup-prod.mjs",
    "init": "node scripts/init.mjs",
    "upgrade-template": "node scripts/upgrade-template.mjs",
    "test:smoke": "node scripts/e2e-smoke.mjs",
    "test:cookies": "bash scripts/test-cookies.sh",
    "test:unit": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:convex": "vitest run",
    "deadcode": "knip",
    "sync:skills:update": "node scripts/sync-skills.mjs --update",
    "sync:linear-docs": "node scripts/sync-linear-docs.mjs"
  },
  "dependencies": {
    "@convex-dev/agent": "^0.6.4",
    "@convex-dev/better-auth": "0.12.2",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/resend": "^0.2.7",
    "@convex-dev/workpool": "^0.4.10",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-router-with-query": "1.130.17",
    "@tanstack/react-start": "1.168.25",
    "@tanstack/react-table": "^8.21.3",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "ai": "^6.0.264",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260429-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "write-excel-file": "^4.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260522.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "convex-test": "^0.0.54",
    "eslint": "^10.9.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "unstorage": "2.0.0-alpha.7"
    }
  }
}
