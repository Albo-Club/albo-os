{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    // TanStack Start file-based routes: referenced via the generated
    // routeTree.gen.ts proxy, never imported directly.
    "src/routes/**/*.{ts,tsx}",
    // Convex functions: referenced through the generated api.* / internal.*
    // proxies (convex/_generated), invisible to static analysis. Top-level
    // files only — convex/lib/** stays analyzed for unused exports.
    "convex/*.ts",
    // One-shot prod migrations, run via `convex run --prod` (MIGRATIONS.md).
    "convex/migrations/*.ts",
    // CLI scripts (some are wired to package.json, others run ad hoc).
    "scripts/*.mjs",
    // Unit tests, run by `pnpm test:unit` glob.
    "tests/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "convex/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"],
  "ignore": [
    // Generated by `convex dev` / codegen.
    "convex/_generated/**",
    // Vendored from Vercel AI Elements registry (CLAUDE.md § Stack).
    "src/components/ai-elements/**",
    // shadcn/ui: managed by the shadcn CLI, audited separately (an unused
    // primitive here is registry inventory, not dead app code).
    "src/components/ui/**"
  ],
  "ignoreDependencies": [
    // Imported from src/styles/app.css (@import / @plugin) — knip does not
    // follow CSS imports.
    "tailwindcss",
    "tw-animate-css"
  ]
}
