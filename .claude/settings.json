{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm run sync:skills:check",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node scripts/session-status.mjs",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "resend@claude-plugins-official": true
  }
}
